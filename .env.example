# Settings for docker-compose. Copy to .env and edit; every value is optional.

# Backend URL as the *browser* sees it (baked into the dashboard at build time).
# Keep localhost if you only open the dashboard on this computer. To open it from a phone as well,
# use this computer's LAN IP, e.g. http://192.168.1.20:8000, and rebuild (docker compose up --build).
PUBLIC_API_URL=http://localhost:8000

# Browser origins allowed to call the API, comma-separated. Add http://<LAN-IP>:3000 if phones
# open the dashboard. The mobile app is not a browser and needs no entry here.
CORS_ORIGINS=http://localhost:3000

JWT_SECRET=dev-secret-change-me
DISPLAY_TIMEZONE=Africa/Lagos
FACE_DISTANCE_THRESHOLD=0.30

# Legacy server-side recognition for old app versions that upload photos only.
# Needs the big image: set both and rebuild (adds ~1 GB plus a 200 MB weight download on first start).
WITH_DEEPFACE=false
FACE_LEGACY=false

# Host ports (change if something else already uses 3000 or 8000)
DASHBOARD_PORT=3000
BACKEND_PORT=8000
