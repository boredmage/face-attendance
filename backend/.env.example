# Copy to .env and edit.

# SQLite (default, zero setup) or PostgreSQL, e.g.
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/attendance
DATABASE_URL=sqlite:///./attendance.db

# Change this in production!
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# deepface  -> real face recognition (requires deepface + tf-keras installed)
# mock      -> accepts any image that contains something; use while developing the UI
FACE_BACKEND=deepface
FACE_MODEL=Facenet512
# Face detector tried first, then the comma-separated fallbacks when it finds no face.
# opencv (Haar) is fast and handles moderately turned heads; retinaface is slower but
# finds faces at sharper angles. Requires opencv-python 4.x (see requirements.txt).
FACE_DETECTOR=opencv
FACE_DETECTOR_FALLBACK=retinaface
# Cosine distance threshold: lower = stricter. 0.30 is a sensible default for Facenet512.
FACE_DISTANCE_THRESHOLD=0.30
# Multi-pose enrolment: each turned-head photo must be within this distance of the frontal one,
# otherwise the enrolment is rejected as "not the same person".
FACE_ENROL_MAX_DISTANCE=0.55
# When a lecturer scans a class, the closest student must beat the next-closest by this distance
FACE_IDENTIFY_MARGIN=0.05
# Load the model and detector weights at start-up (recommended; first request is otherwise slow)
FACE_WARM_UP=true

# Where enrolled face images are saved
FACE_IMAGE_DIR=./face_images

# A class left running this many hours is ended automatically
SESSION_AUTO_END_HOURS=4
# Timezone for weekday statistics and CSV export times
DISPLAY_TIMEZONE=Africa/Lagos

# Browser origins allowed to call the API (the lecturer dashboard), comma-separated
CORS_ORIGINS=http://localhost:3000
